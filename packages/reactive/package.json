{
    "name": "@sky-modules/reactive",
    "type": "module",
    "version": "0.0.0",
    "private": true,
    "description": "Fine-grained reactive system with decorators, validation, and network lamps",
    "keywords": [
        "reactive",
        "signals",
        "solid",
        "decorators",
        "validation"
    ],
    "license": "MIT",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./define": "./src/define.ts",
        "./lamps": "./src/lamps/index.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "play": "vite --config playground/vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@sky-modules/define": "workspace:*",
        "@sky-modules/schema": "workspace:*",
        "solid-js": "^2.0.3"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
