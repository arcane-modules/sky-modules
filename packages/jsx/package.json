{
    "name": "@sky-modules/jsx",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "Solid 2 universal renderer: reactive JSX for any scene graph",
    "keywords": [
        "jsx",
        "jsx-runtime",
        "universal",
        "cross-framework",
        "solid-js"
    ],
    "license": "MIT",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./jsx-runtime": "./src/jsx-runtime.ts",
        "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
        "./vite": "./src/vite.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "play": "vite --config playground/vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "solid-js": "^2.0.3"
    },
    "devDependencies": {
        "solid-js": "^2.0.3",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "dependencies": {
        "@solidjs/compiler": "2.0.2",
        "@solidjs/universal": "2.0.3"
    }
}
