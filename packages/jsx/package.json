{
    "name": "@sky-modules/jsx",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "description": "Universal JSX runtime based on SolidJS for cross-framework components",
    "keywords": [
        "jsx",
        "jsx-runtime",
        "universal",
        "cross-framework",
        "solid-js"
    ],
    "license": "MIT",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./jsx-runtime": "./src/jsx-runtime.ts",
        "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
        "./jsx-universal": "./src/jsx-universal.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "play": "vite --config playground/vite.config.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "peerDependencies": {
        "solid-js": "^1.9.10"
    },
    "devDependencies": {
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
